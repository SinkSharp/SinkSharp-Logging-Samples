<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>SinkSharp.OpenTelemetrySample</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SinkSharp.Core" Version="1.0.10" />
    <PackageReference Include="SinkSharp.Sinks.Console" Version="1.0.1" />
    <PackageReference Include="SinkSharp.Sinks.Dashboard" Version="1.0.5" />
	<PackageReference Include="SinkSharp.Sinks.OpenTelemetry" Version="1.0.1" />

     <!--
      OTel instrumentation packages — used in the AddSinkSharpTracing callback.
      Only the caller references these; SinkSharp.Sinks.OpenTelemetry itself
      does not depend on instrumentation packages.
    -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageReference Include="System.Text.Encodings.Web" Version="10.0.15" />
  </ItemGroup>
</Project>
